<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alex Morgan | Professional Portfolio</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- 1. Header / Navigation Section -->
    <header class="navbar">
        <div class="nav-container">
            <a href="#home" class="logo">Alex<span>.M</span></a>
            <nav>
                <ul class="nav-links">
                    <li><a href="#home">Home</a></li>
                    <li><a href="#about">About</a></li>
                    <li><a href="#skills">Skills</a></li>
                    <li><a href="#projects">Projects</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <!-- 2. Hero / Home Section -->
        <section id="home" class="hero-section">
            <div class="hero-content">
                <h1>Hi, I'm <span class="highlight">Alex Morgan</span></h1>
                <h2>Aspiring Frontend Developer</h2>
                <p>I build clean, accessible, and responsive user interfaces for modern web applications using foundational web technologies.</p>
                <a href="#projects" class="btn">View My Work</a>
            </div>
        </section>

        <!-- 3. About Me Section -->
        <section id="about" class="about-section">
            <div class="section-container">
                <h3 class="section-title">About Me</h3>
                <div class="about-content">
                    <p>I am a highly motivated Computer Science student deeply passionate about modern web design systems and interface layout patterns. Currently refining my skills through practical software build sprints and open-source contributions.</p>
                    <p><strong>Education:</strong> Bachelor of Science in Information Technology (Expected Graduation: 2027)</p>
                    <p><strong>Career Interests:</strong> UI Engineering, Interactive Web App Design, and Frontend Architecture Systems.</p>
                </div>
            </div>
        </section>

        <!-- 4. Skills Section (Minimum 5 labels/chips) -->
        <section id="skills" class="skills-section">
            <div class="section-container">
                <h3 class="section-title">Technical Skills</h3>
                <div class="skills-grid">
                    <span class="skill-chip">Semantic HTML5</span>
                    <span class="skill-chip">CSS3 Responsive Systems</span>
                    <span class="skill-chip">Flexbox & Grid layouts</span>
                    <span class="skill-chip">Web Accessibility (a11y)</span>
                    <span class="skill-chip">Version Control (Git)</span>
                </div>
            </div>
        </section>

        <!-- 5. Projects Section (Minimum 2 cards) -->
        <section id="projects" class="projects-section">
            <div class="section-container">
                <h3 class="section-title">Featured Projects</h3>
                <div class="projects-grid">
                    <!-- Project Card 1 -->
                    <article class="project-card">
                        <div class="project-info">
                            <h4>Eco-Track Landing Page</h4>
                            <p>A responsive landing page layout designed for an environmental tracking tool framework emphasizing structural readability.</p>
                            <div class="project-tech">
                                <span>HTML5</span>
                                <span>CSS Variables</span>
                                <span>Flexbox</span>
                            </div>
                        </div>
                    </article>
                    <!-- Project Card 2 -->
                    <article class="project-card">
                        <div class="project-info">
                            <h4>Recipe Dashboard UI</h4>
                            <p>A multi-column client interface designed to render catalogued grid configurations seamlessly across standard device widths.</p>
                            <div class="project-tech">
                                <span>HTML5 Layouts</span>
                                <span>CSS Grid</span>
                                <span>Media Queries</span>
                            </div>
                        </article>
                </div>
            </div>
        </section>

        <!-- 6. Contact Section -->
        <section id="contact" class="contact-section">
            <div class="section-container">
                <h3 class="section-title">Get In Touch</h3>
                <p class="contact-intro">Feel free to connect or drop an inquiry via email or my professional network links below.</p>
                
                <div class="contact-wrapper">
                    <!-- Optional: Visual Demo Contact Form -->
                    <form class="contact-form" onsubmit="event.preventDefault();">
                        <small class="form-disclaimer"><em>* Note: This form is a visual demo simulation only.</em></small>
                        <div class="form-group">
                            <label for="name">Name</label>
                            <input type="text" id="name" placeholder="Your Name" required>
                        </div>
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" placeholder="Your Email Address" required>
                        </div>
                        <button type="submit" class="btn">Send Message</button>
                    </form>

                    <div class="contact-links">
                        <p><strong>Email:</strong> <a href="mailto:alex.morgan@example.com">alex.morgan@example.com</a></p>
                        <p><strong>LinkedIn:</strong> <a href="https://linkedin.com" target="_blank" rel="noopener">://linkedin.com</a></p>
                        <p><strong>GitHub:</strong> <a href="https://github.com" target="_blank" rel="noopener">://github.com</a></p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- 7. Footer Section -->
    <footer class="main-footer">
        <p>&copy; 2026 Alex Morgan. All Rights Reserved.</p>
    </footer>

</body>
</html>
